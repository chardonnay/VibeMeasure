<Window
    x:Class="VibeMeasure.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VibeMeasure">
    <Grid Padding="18" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Image Source="ms-appx:///Assets/pegelbot.png" Width="28" Height="28"
                   AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="Usage Monitor" FontSize="20" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ComboBox x:Name="Mode" Header="Display mode" SelectedIndex="0"
                      SelectionChanged="ModeChanged">
                <ComboBoxItem Content="Provider cycles" Tag="provider-cycles" />
                <ComboBoxItem Content="5 hours" Tag="five-hours" />
                <ComboBoxItem Content="1 week" Tag="one-week" />
                <ComboBoxItem Content="1 month" Tag="one-month" />
            </ComboBox>
            <Button Content="Refresh" VerticalAlignment="Bottom" Click="RefreshClicked" />
        </StackPanel>
        <ScrollViewer Grid.Row="2">
            <TextBlock x:Name="Summary" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                       AutomationProperties.LiveSetting="Polite" />
        </ScrollViewer>
    </Grid>
</Window>
